MONGO_URI=mongodb://127.0.0.1:27017/nb-classic-scents
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=30d
PORT=5000
CLIENT_URL=http://localhost:5173
ADMIN_NAME=NB Admin
ADMIN_EMAIL=admin@nbclassicscents.com
ADMIN_PASSWORD=ChangeMe123!

# Optional: Cloudinary credentials (from cloudinary.com dashboard, free tier).
# When all three are set, admin-uploaded images (product photos, and the
# hero-slide/collection photos under Admin -> Homepage) are stored in
# Cloudinary so they survive host restarts/redeploys (e.g. on Render's free
# tier, which wipes local disk on every restart). Leave blank for local dev -
# uploads then fall back to local disk under server/uploads/products/.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
